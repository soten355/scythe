{
  "name": "scythe",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/content",
    "packages/bots",
    "packages/app",
    "tools"
  ],
  "scripts": {
    "dev": "npm run dev -w @scythe/app",
    "build": "npm run build -w @scythe/app",
    "preview": "npm run preview -w @scythe/app",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine && tsc -p packages/content && tsc -p packages/bots && tsc -p packages/app && tsc -p tools",
    "sim": "npm run sim -w @scythe/tools"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
